{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "33643302-43a2-4545-b94d-7743f4356c0d","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "2e90704f552545659c2a0d5676ddfe86" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
